# Copy to .env and edit. Generate a secret with: openssl rand -hex 32
BALLAST_ENV=development
BALLAST_SECRET_KEY=
BALLAST_BASE_CURRENCY=USD
BALLAST_DUAL_APPROVAL_THRESHOLD=50000
BALLAST_MAX_BANK_CONCENTRATION=0.35
BALLAST_MIN_LIQUIDITY_BUFFER=10000000
BALLAST_CORS_ORIGINS=http://localhost:4200
# Optional: persist users, payments, hedges, netting cycles and the audit log across restarts
# BALLAST_DATA_PATH=./data
# Self-registration is open in development and closed otherwise (the first account still becomes Admin).
# BALLAST_ALLOW_SELF_REGISTRATION=false
# Set to true when running behind a reverse proxy you control (nginx, ingress) so rate limiting sees real client IPs.
# BALLAST_TRUST_PROXY=false
# Demo users are seeded automatically when BALLAST_ENV=development.
# In production set BALLAST_SEED_DEMO_DATA=false (default) or provide your own BALLAST_DEMO_PASSWORD.
