# Build context: repository root
#   docker build -f infrastructure/docker/Dockerfile.backend -t ballast-backend .
FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src
COPY code/ code/
RUN dotnet publish code/backend/app/Ballast.Api.csproj -c Release -o /out

FROM mcr.microsoft.com/dotnet/aspnet:10.0 AS runtime
WORKDIR /app
ENV ASPNETCORE_URLS=http://+:8080 \
    DOTNET_EnableDiagnostics=0 \
    BALLAST_ENV=production \
    BALLAST_DATA_PATH=/data
RUN mkdir -p /data && chown app:app /data
COPY --from=build --chown=app:app /out .
USER app
EXPOSE 8080
VOLUME ["/data"]
ENTRYPOINT ["dotnet", "Ballast.Api.dll"]
