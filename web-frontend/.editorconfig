# Editor configuration, see https://editorconfig.org
root = true

[*]
charset = utf-8
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

[*.{ts,html,css}]
# Prettier reads this as printWidth. It matches .prettierrc, so the width holds even when a tool skips .prettierrc.
max_line_length = 100

[*.{ts,css}]
quote_type = single

[*.ts]
ij_typescript_use_double_quotes = false

[*.md]
max_line_length = off
trim_trailing_whitespace = false
