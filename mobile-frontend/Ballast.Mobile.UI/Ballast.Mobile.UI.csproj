<Project Sdk="Microsoft.NET.Sdk.Razor">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Ballast.Mobile.UI</RootNamespace>
  </PropertyGroup>
  <!--
    This project compiles against the ASP.NET Core shared framework, but the reference is private so it does not flow to
    consumers. The test project declares its own framework reference. The MAUI host has no shared framework on mobile, so it
    gets the same Microsoft.AspNetCore.Components assemblies from the Blazor WebView packages it already references.

    An earlier version switched between this reference and a package with a BallastUsePackages property passed through
    ProjectReference AdditionalProperties. NuGet restore does not see those properties, so restore recorded the framework
    reference while the build removed it, and the build failed with missing Microsoft.AspNetCore namespaces.
  -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" PrivateAssets="all" />
  </ItemGroup>
</Project>
